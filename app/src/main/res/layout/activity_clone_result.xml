<?xml version="1.0" encoding="utf-8"?>
<!--
    Layar 4 "Selesai" (DESAIN.md section 4).
    Success badge + headline, APK summary card and the three action rows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wave"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Widget.OpenClone.IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.OpenClone.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/title_clone_result" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_result_badge">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_success"
                    android:src="@drawable/ic_check"
                    app:tint="@color/accent_white" />
            </FrameLayout>

            <TextView
                android:id="@+id/resultHeadline"
                style="@style/Text.OpenClone.HeroHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/success_headline" />

            <TextView
                android:id="@+id/resultSubtitle"
                style="@style/Text.OpenClone.Detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3sp"
                android:text="@string/success_subtitle" />

            <!-- Single APK summary -->
            <LinearLayout
                android:id="@+id/singleSummaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/resultIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_squircle"
                    android:contentDescription="@string/cd_app_icon"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    tools:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/resultName"
                        style="@style/Text.OpenClone.ItemTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="WhatsApp (Clone 1)" />

                    <TextView
                        android:id="@+id/resultPackage"
                        style="@style/Text.OpenClone.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="com.whatsapp.clone1" />

                    <TextView
                        android:id="@+id/resultSize"
                        style="@style/Text.OpenClone.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="12,6 MB" />
                </LinearLayout>
            </LinearLayout>

            <!-- Multi-clone batch summary list -->
            <LinearLayout
                android:id="@+id/batchListCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/batchResultList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Honest limitation note: clones get a different package name and
                 a different signing certificate, so anything that checks the
                 original signature (Google Sign-In, Play Integrity) refuses. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_outlined"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/Text.OpenClone.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/clone_limit_title"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Text.OpenClone.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2sp"
                    android:text="@string/clone_limit_body" />
            </LinearLayout>

            <!-- Compatibility findings: declarations in the source manifest
                 that a re-signed copy cannot satisfy. Hidden when empty. -->
            <LinearLayout
                android:id="@+id/compatCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_outlined"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Text.OpenClone.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/compat_title"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/compatList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Identity facts the user can verify after installing. -->
            <LinearLayout
                android:id="@+id/identityCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_outlined"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Text.OpenClone.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/identity_title"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/identityList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <Button
                android:id="@+id/installButton"
                style="@style/Widget.OpenClone.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:drawableStart="@drawable/ic_install"
                android:drawablePadding="8dp"
                android:drawableTint="@color/text_on_white"
                android:text="@string/install_app" />

            <LinearLayout
                android:id="@+id/secondaryActionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/shareButton"
                    style="@style/Widget.OpenClone.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_share"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/accent_white"
                    android:text="@string/share_apk" />

                <Button
                    android:id="@+id/viewFileButton"
                    style="@style/Widget.OpenClone.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_folder"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/accent_white"
                    android:text="@string/view_file" />
            </LinearLayout>

            <Button
                android:id="@+id/createAnotherButton"
                style="@style/Widget.OpenClone.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_add"
                android:drawablePadding="8dp"
                android:drawableTint="@color/accent_white"
                android:text="@string/create_another" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
