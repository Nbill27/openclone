<?xml version="1.0" encoding="utf-8"?>
<!-- One checklist row on Proses Cloning (DESAIN.md section 4, Layar 3). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:id="@+id/stepIndicator"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_step_pending">

        <ImageView
            android:id="@+id/stepCheck"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/text_on_white" />
    </FrameLayout>

    <TextView
        android:id="@+id/stepLabel"
        style="@style/Text.OpenClone.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:textColor="@color/text_muted"
        tools:text="Menyalin file aplikasi" />
</LinearLayout>
