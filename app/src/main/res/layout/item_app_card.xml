<?xml version="1.0" encoding="utf-8"?>
<!-- Installed app row (DESAIN.md section 4, Layar 1): 48dp squircle icon,
     name + package, and a white Clone pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_ripple"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_icon_squircle"
        android:contentDescription="@string/cd_app_icon"
        android:padding="7dp"
        android:scaleType="fitCenter"
        tools:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/appName"
            style="@style/Text.OpenClone.ItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="WhatsApp" />

        <TextView
            android:id="@+id/appPackage"
            style="@style/Text.OpenClone.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="com.whatsapp" />
    </LinearLayout>

    <TextView
        android:id="@+id/cloneAction"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_pill_clone_touch"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/clone_action"
        android:textColor="@color/text_on_white"
        android:textSize="13sp" />
</LinearLayout>
