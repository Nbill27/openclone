<?xml version="1.0" encoding="utf-8"?>
<!-- Clone history row (DESAIN.md section 4, Layar 5). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_ripple"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="4dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/historyIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_icon_squircle"
        android:contentDescription="@string/cd_app_icon"
        android:padding="7dp"
        android:scaleType="fitCenter"
        tools:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/historyName"
            style="@style/Text.OpenClone.ItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="WhatsApp (Clone 1)" />

        <TextView
            android:id="@+id/historyMeta"
            style="@style/Text.OpenClone.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="12,6 MB • 24 Nov 2026 15:28" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/historyStatus"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_badge_success">

        <ImageView
            android:id="@+id/historyStatusIcon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_success"
            android:src="@drawable/ic_check"
            app:tint="@color/text_on_white" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/historyMenu"
        style="@style/Widget.OpenClone.IconButton"
        android:layout_marginStart="2dp"
        android:contentDescription="@string/cd_more"
        android:src="@drawable/ic_more_vert" />
</LinearLayout>
