<?xml version="1.0" encoding="utf-8"?>
<!-- 4-column app tile (DESAIN.md section 4, Layar 6). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_tile"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/tileIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_squircle"
        android:contentDescription="@string/cd_app_icon"
        android:padding="6dp"
        android:scaleType="fitCenter"
        tools:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/tileName"
        style="@style/Text.OpenClone.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/accent_white"
        tools:text="WhatsApp" />
</LinearLayout>
