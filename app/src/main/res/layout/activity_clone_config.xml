<?xml version="1.0" encoding="utf-8"?>
<!--
    Layar 2 "Buat Salinan" (DESAIN.md section 4, Varian B).
    Back + title, source app identity, "Konfigurasi Clone" card, the advanced
    options accordion and the white primary CTA pinned to the bottom.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Widget.OpenClone.IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.OpenClone.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/title_new_clone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Source app identity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/sourceIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_squircle"
                    android:contentDescription="@string/cd_app_icon"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    tools:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/sourceName"
                        style="@style/Text.OpenClone.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="WhatsApp" />

                    <TextView
                        android:id="@+id/sourcePackage"
                        style="@style/Text.OpenClone.Detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="com.whatsapp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Konfigurasi Clone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Text.OpenClone.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_section" />

                <TextView
                    style="@style/Text.OpenClone.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/label_app_name" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/nameInput"
                        style="@style/Text.OpenClone.ItemTitle"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="@string/label_app_name"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/accent_white"
                        android:textColorHint="@color/text_muted"
                        android:textSize="15sp"
                        tools:ignore="Autofill"
                        tools:text="WhatsApp (Clone 1)" />

                    <ImageButton
                        android:id="@+id/clearNameButton"
                        style="@style/Widget.OpenClone.IconButton"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/cd_clear_name"
                        android:padding="14dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    style="@style/Text.OpenClone.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_package_name" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/packageInput"
                        style="@style/Text.OpenClone.Body"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:hint="@string/label_package_name"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/accent_white"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp"
                        tools:ignore="Autofill"
                        tools:text="com.whatsapp.clone1" />

                    <ImageButton
                        android:id="@+id/resetPackageButton"
                        style="@style/Widget.OpenClone.IconButton"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/cd_reset_package"
                        android:padding="14dp"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    style="@style/Text.OpenClone.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_app_icon" />

                <ImageView
                    android:id="@+id/iconPreview"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_icon_squircle"
                    android:contentDescription="@string/cd_app_icon"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    tools:src="@mipmap/ic_launcher" />

                <Button
                    android:id="@+id/changeIconButton"
                    style="@style/Widget.OpenClone.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/change_icon" />
            </LinearLayout>

            <!-- Opsi Lanjutan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/advancedHeader"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_row_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        style="@style/Text.OpenClone.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/advanced_options" />

                    <ImageView
                        android:id="@+id/advancedChevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/advancedContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.OpenClone.Detail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/advanced_version" />

                        <TextView
                            android:id="@+id/advancedVersionValue"
                            style="@style/Text.OpenClone.Detail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/accent_white"
                            tools:text="2.24.1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.OpenClone.Detail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/advanced_splits" />

                        <TextView
                            android:id="@+id/advancedSplitsValue"
                            style="@style/Text.OpenClone.Detail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/accent_white"
                            tools:text="Tidak ada" />
                    </LinearLayout>

                    <!-- Advertising ID: the clone can drop the AD_ID permission
                         so the app reports no advertising identifier instead of
                         sharing the original's one. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.OpenClone.Detail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/advanced_strip_ad_id" />

                            <TextView
                                style="@style/Text.OpenClone.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/advanced_strip_ad_id_desc" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/stripAdIdSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:checked="false"
                            android:contentDescription="@string/advanced_strip_ad_id" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_canvas"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/createButton"
            style="@style/Widget.OpenClone.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_copy"
            android:drawablePadding="8dp"
            android:drawableTint="@color/text_on_white"
            android:text="@string/create_clone" />
    </LinearLayout>
</LinearLayout>
