<?xml version="1.0" encoding="utf-8"?>
<!--
    Password prompt for keystore export and import.
    The same dialog is reused for both flows; only the title and helper
    text change, so the layout stays deliberately minimal.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="0dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/passwordLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/keystore_password_hint"
        app:boxStrokeColor="@color/border_input"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/accent_white" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/Text.OpenClone.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/keystore_password_helper" />

    <TextView
        style="@style/Text.OpenClone.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/keystore_password_warning"
        android:textColor="@color/warning_text" />
</LinearLayout>
