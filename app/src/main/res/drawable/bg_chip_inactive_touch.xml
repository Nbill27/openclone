<?xml version="1.0" encoding="utf-8"?>
<!-- 48dp touch target with a 34dp visual pill, as in DESAIN.md section 4. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="34dp"
        android:gravity="center">
        <ripple android:color="@color/ripple_white_8">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_white" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/bg_surface" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/border_subtle" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
